    "REMINDER_HOUR": "8"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hermes-mini",
      "database_id": "e97ecd22-5936-4531-8418-d73794ff243f"
    }
  ],
  "observability": {
    "enabled": true
  }
}